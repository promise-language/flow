+
+// SaveWorkInProgress stores what a step worked out against that step's result
+// id on this item.
+func (b *Backend) SaveWorkInProgress(ctx context.Context, claim flow.Claim, step, body string) error {
+	itemID, err := refID(claim.ItemRef)
+	if err != nil {
+		return err
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
