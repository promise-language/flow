+func commitFile(t *testing.T, dir, name, content, message string) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	gitInTest(t, dir, "add", name)
+	gitInTest(t, dir, "commit", "-m", message)
+}
